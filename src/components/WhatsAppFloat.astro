---
// Bouton WhatsApp flottant.
// Il se masque automatiquement quand un bloc marqué [data-hide-wa] est à l'écran
// (boutons WhatsApp du hero, section contact, pied de page) : il ne recouvre donc
// jamais le formulaire, les liens du footer ni un autre bouton WhatsApp.
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const t = useTranslations(Astro.props.lang);
---

<a
  href={whatsappLink(t.whatsapp.default)}
  target="_blank"
  rel="noopener"
  data-wa-float
  class="fixed bottom-4 right-4 z-50 inline-flex h-14 min-w-14 items-center justify-center gap-2.5 rounded-full bg-ink px-4 text-white shadow-[0_10px_30px_-10px_rgb(44_49_55/0.7)] ring-1 ring-white/10 transition-[transform,opacity,background-color] duration-300 hover:bg-[#1d2125] sm:bottom-6 sm:right-6 sm:pr-5"
  aria-label={t.common.whatsappFloatAria}
>
  <Icon name="whatsapp" size={26} class="text-whatsapp" />
  <span class="hidden font-semibold sm:inline">WhatsApp</span>
</a>

<script>
  // Masque le bouton dès qu'une zone [data-hide-wa] chevauche l'écran.
  // Calcul direct au scroll (throttlé par requestAnimationFrame) : fiable partout.
  const btn = document.querySelector<HTMLElement>('[data-wa-float]');
  const zones = Array.from(document.querySelectorAll<HTMLElement>('[data-hide-wa]'));
  if (btn && zones.length) {
    let queued = false;
    const update = () => {
      queued = false;
      const vh = window.innerHeight;
      const hide = zones.some((z) => {
        const r = z.getBoundingClientRect();
        return r.bottom > 0 && r.top < vh;
      });
      btn.classList.toggle('is-hidden', hide);
      btn.toggleAttribute('inert', hide);
      btn.setAttribute('aria-hidden', String(hide));
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    update();
  }
</script>
