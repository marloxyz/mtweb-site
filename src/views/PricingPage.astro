---
// Page Tarifs (FR et EN) : tableau récapitulatif « à partir de ».
// Textes et lignes : pricingPage dans src/i18n/fr.ts et en.ts. Montants : src/data/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import TitleText from '../components/TitleText.astro';
import { site, prices, whatsappLink } from '../data/site';
import { localePath, useTranslations, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const p = t.pricingPage;
const href = (key: RouteKey) => localePath(key, lang);
const abs = (path: string) => `${site.url}${path}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'OfferCatalog',
    name: p.tableCaption,
    url: abs(href('pricing')),
    itemListElement: [
      { name: p.rows[0].name, price: prices.site },
      { name: p.rows[1].name, price: prices.siteNfc },
      { name: p.rows[2].name, price: prices.logo },
      { name: p.rows[3].name, price: prices.businessCards },
    ].map((o) => ({
      '@type': 'Offer',
      name: o.name,
      price: o.price,
      priceCurrency: 'EUR',
      seller: { '@id': `${site.url}/#mtweb` },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.common.breadcrumbHome, item: abs(href('home')) },
      { '@type': 'ListItem', position: 2, name: t.pages.pricing, item: abs(href('pricing')) },
    ],
  },
];
---

<BaseLayout lang={lang} routeKey="pricing" title={p.title} description={p.description} schema={schema}>
  <section class="container-site pb-16 pt-8 sm:pt-12 lg:pb-20 lg:pt-16">
    <nav aria-label={t.serviceUi.breadcrumb} class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href={href('home')} class="tap hover:text-ink hover:underline">{t.common.breadcrumbHome}</a></li>
        <li aria-hidden="true" class="px-1">/</li>
        <li aria-current="page" class="font-medium text-ink">{t.pages.pricing}</li>
      </ol>
    </nav>
    <p class="eyebrow mt-4">{p.eyebrow}</p>
    <h1 class="mt-4 text-[clamp(40px,5vw,96px)] font-semibold leading-[1.04]">
      <TitleText title={p.heading} />
    </h1>
    <p class="measure mt-6 text-[clamp(1.125rem,1.1vw,1.5rem)] leading-relaxed text-muted">{p.intro}</p>
  </section>

  <!-- Tableau récapitulatif (cartes empilées sur mobile, tableau dès 768 px) -->
  <section class="container-site" aria-label={p.tableCaption}>
    <div class="card crop overflow-hidden" data-reveal>
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">{p.tableCaption}</caption>
        <thead class="hidden bg-paper/60 md:table-header-group">
          <tr class="border-b border-line text-sm uppercase tracking-[0.1em]">
            <th scope="col" class="px-8 py-4 font-semibold">{p.colService}</th>
            <th scope="col" class="px-4 py-4 font-semibold">{p.colIncluded}</th>
            <th scope="col" class="px-8 py-4 text-right font-semibold">{p.colPrice}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {
            p.rows.map((row) => (
              <tr class="grid gap-2 p-6 md:table-row md:p-0">
                <th scope="row" class="font-display text-xl font-semibold md:px-8 md:py-6 md:align-top">
                  <a href={href(row.key)} class="hover:underline">
                    {row.name}
                  </a>
                </th>
                <td class="leading-relaxed text-muted md:px-4 md:py-6 md:align-top">{row.included}</td>
                <td class="font-display text-2xl font-semibold text-blue-dark md:whitespace-nowrap md:px-8 md:py-6 md:text-right md:align-top">
                  <span class="mr-2 font-sans text-sm font-normal text-muted md:hidden">{p.colPrice}</span>
                  {row.price}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-sm text-muted">{`${t.common.netPrices} ${t.common.vatNotice}.`}</p>
  </section>

  <!-- Hébergement : abonnement séparé -->
  <section class="container-site py-16 lg:py-24" aria-labelledby="hosting-title">
    <div class="grid gap-8 rounded-xl bg-surface p-6 sm:p-10 lg:grid-cols-[1.2fr_1fr] lg:items-center lg:p-14" data-reveal>
      <div>
        <h2 id="hosting-title" class="text-[clamp(2rem,2.8vw,3.25rem)] font-semibold leading-tight">
          {p.hosting.title}<span class="text-red">.</span>
        </h2>
        <p class="measure mt-4 text-lg leading-relaxed text-muted">{p.hosting.text}</p>
        <p class="mt-6 font-display text-4xl font-semibold text-blue-dark">{p.hosting.price}</p>
      </div>
      <ul class="space-y-3">
        {
          p.hosting.items.map((item) => (
            <li class="flex gap-3">
              <Icon name="check" size={22} class="mt-0.5 shrink-0 text-blue-dark" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pack + devis -->
  <section class="container-site grid gap-8 lg:grid-cols-2" data-hide-wa>
    <div class="flex flex-col gap-4 rounded-xl bg-blue-dark p-6 text-white sm:p-10" data-reveal>
      <h2 class="text-2xl font-semibold sm:text-3xl">{p.packTitle}<span class="text-yellow">.</span></h2>
      <p class="measure flex-1 text-white/90">{p.packText}</p>
      <a href={`${href('home')}#pack`} class="btn self-start bg-white text-ink hover:bg-paper">
        {p.packCta}
        <Icon name="arrow" size={18} />
      </a>
    </div>
    <div class="flex flex-col gap-4 rounded-xl bg-ink p-6 text-white sm:p-10" data-reveal style="--reveal-delay:80ms">
      <h2 class="text-2xl font-semibold sm:text-3xl">{p.quoteTitle}</h2>
      <p class="measure flex-1 text-white/85">{p.quoteText}</p>
      <a href={whatsappLink(t.whatsapp.default)} class="btn self-start bg-white text-ink hover:bg-paper" target="_blank" rel="noopener">
        <Icon name="whatsapp" class="text-[#128c7e]" />
        {t.common.whatsappCta}
      </a>
    </div>
  </section>
</BaseLayout>
