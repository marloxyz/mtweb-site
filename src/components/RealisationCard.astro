---
// Vignette de réalisation.
// - Si /public/realisations/<slug>.webp existe au moment du build : l'image s'affiche
//   (et le lien vers le site, s'il est renseigné).
// - Sinon : cadre vide en 16:10, sans texte ni image factice.
// Toutes les vignettes sont en 16:10 (sites comme imprimés) pour aligner les lignes de la grille.
import fs from 'node:fs';
import path from 'node:path';
import type { Realisation } from '../data/realisations';
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  item: Realisation;
  headingLevel?: 'h3' | 'h2';
}
const { lang, item, headingLevel: H = 'h3' } = Astro.props;
const t = useTranslations(lang);

const file = `/realisations/${item.slug}.webp`;
const hasImage = fs.existsSync(path.join(process.cwd(), 'public', file));
const [w, h] = [1600, 1000];
const link = hasImage && item.url ? item.url : undefined;
const label = item.detail?.[lang] ?? t.realisations.type[item.type];
const alt = t.realisations.previewAlt(item.name, label);
---

<article class="group" data-type={item.type}>
  <div
    class:list={[
      'aspect-[16/10] overflow-hidden rounded-md border border-frame-line bg-frame',
      link && 'card-hover transition',
    ]}
  >
    {
      hasImage &&
        (link ? (
          <a href={link} target="_blank" rel="noopener" class="block h-full">
            <img
              src={file}
              alt={alt}
              width={w}
              height={h}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.02]"
            />
            <span class="sr-only">({t.common.newWindow})</span>
          </a>
        ) : (
          <img
            src={file}
            alt={alt}
            width={w}
            height={h}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-top"
          />
        ))
    }
  </div>
  <div class="mt-3 flex items-baseline justify-between gap-3">
    <H class="font-display text-lg font-semibold">{item.name}</H>
    <p class="text-sm text-muted">{label}</p>
  </div>
</article>
