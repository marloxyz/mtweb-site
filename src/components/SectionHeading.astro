---
// Titre de section : surtitre + titre (avec point rouge final) + chapô.
// Utiliser le slot « title » pour insérer un surlignage <span class="hl">.
interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
  align?: 'left' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, intro, id, align = 'left', as: Tag = 'h2' } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center']} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag id={id} class="mt-3 text-[clamp(2rem,2.8vw,4rem)] font-semibold leading-[1.08]">
    {title}<slot name="title" /><span class="text-red">.</span>
  </Tag>
  {intro && <p class:list={['measure mt-4 text-lg leading-relaxed text-muted', align === 'center' && 'mx-auto']}>{intro}</p>}
</div>
