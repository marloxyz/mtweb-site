---
// Pages légales (français uniquement) : mentions légales, confidentialité, CGV.
// Textes : src/content/legal/*.md. L'adresse ({{ADRESSE}}) vient de src/data/site.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { localePath, useTranslations, type RouteKey } from '../i18n';
import type { MarkdownInstance } from 'astro';

interface Props {
  routeKey: Extract<RouteKey, 'legal' | 'privacy' | 'terms'>;
  doc: MarkdownInstance<Record<string, any>>;
}
const { routeKey, doc } = Astro.props;
const t = useTranslations('fr');
const fm = doc.frontmatter as { title: string; seoTitle: string; description: string; updated: string };
const html = (await doc.compiledContent()).replaceAll('{{ADRESSE}}', site.address);
---

<BaseLayout lang="fr" routeKey={routeKey} title={fm.seoTitle} description={fm.description}>
  <article class="container-site pb-8 pt-8 sm:pt-12 lg:pt-16">
    <nav aria-label={t.serviceUi.breadcrumb} class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1">
        <li><a href={localePath('home', 'fr')} class="tap hover:text-ink hover:underline">{t.common.breadcrumbHome}</a></li>
        <li aria-hidden="true" class="px-1">/</li>
        <li aria-current="page" class="font-medium text-ink">{t.pages[routeKey]}</li>
      </ol>
    </nav>
    <h1 class="mt-4 text-[clamp(40px,4.5vw,80px)] font-semibold leading-[1.05]">
      {fm.title}<span class="text-red">.</span>
    </h1>
    <p class="mt-4 text-sm text-muted">Dernière mise à jour : {fm.updated}</p>
    <div class="prose-legal mt-10" set:html={html} />
  </article>
</BaseLayout>
